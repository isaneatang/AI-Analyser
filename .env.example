# AI Wallet Investigator - Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Reown AppKit (client-side, safe to expose via VITE_)
VITE_REOWN_PROJECT_ID=

# BOT Chain RPC (server-side only)
# Active network is chosen by BOT_NETWORK (testnet | mainnet).
BOT_NETWORK=testnet
BOT_RPC_URL=https://rpc.bohr.life
# Optional per-network RPC overrides:
# BOT_TESTNET_RPC_URL=https://rpc.bohr.life
# BOT_MAINNET_RPC_URL=

# Moralis EVM API (server-side only; used ONLY for cross-chain token data)
MORALIS_API_KEY=

# CoinGecko (server-side only)
# Free Demo keys ('CG-...') use api.coingecko.com automatically.
# Paid Pro plans: set COINGECKO_PLAN=pro to switch endpoints.
COINGECKO_API_KEY=
# COINGECKO_PLAN=pro

# Gemini AI (server-side only). Free key: https://aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Optional fallback provider used when Gemini times out or 503s.
# Free key: https://console.groq.com - very fast, generous free tier.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Per-request AI timeout in ms (default 45000)
# AI_REQUEST_TIMEOUT_MS=45000

# Server config
PORT=3001
CLIENT_URL=http://localhost:5173

# On-chain InvestigationRegistry (optional; see contracts/InvestigationRegistry.sol)
# Deploy with: npm run deploy:registry
# REGISTRY_CONTRACT=0x... deployed contract address
# BOT_PRIVATE_KEY=0x... funded BOT Chain key that pays anchor gas
