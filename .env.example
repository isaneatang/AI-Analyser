# AI Wallet Investigator - Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Reown AppKit (client-side, safe to expose via VITE_)
VITE_REOWN_PROJECT_ID=

# BOT Chain RPC (server-side only)
# Active network is chosen by BOT_NETWORK (testnet | mainnet).
BOT_NETWORK=mainnet
# BOT_RPC_URL overrides every network-specific URL. Leave it unset to use the
# selected network's URL below.
# BOT_RPC_URL=
# Optional per-network RPC overrides:
# BOT_TESTNET_RPC_URL=https://rpc.bohr.life
# BOT_MAINNET_RPC_URL=

# Moralis EVM API (server-side only; used ONLY for cross-chain token data)
MORALIS_API_KEY=

# CoinGecko (server-side only)
# Free Demo keys ('CG-...') use api.coingecko.com automatically.
# Paid Pro plans: set COINGECKO_PLAN=pro to switch endpoints.
COINGECKO_API_KEY=
# COINGECKO_PLAN=pro

# AI providers (server-side only). OpenRouter is tried first when configured.
# Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free
# APP_URL=https://your-production-domain.example

# Gemini AI. Free key: https://aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Optional fallback provider used when OpenRouter fails.
# Free key: https://console.groq.com - very fast, generous free tier.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# Per-provider timeout. Keep below Vercel's 30 second function limit.
# AI_REQUEST_TIMEOUT_MS=8000

# Server config
PORT=3001
CLIENT_URL=http://localhost:5173

# On-chain InvestigationRegistry (optional; see contracts/InvestigationRegistry.sol)
# Deploy with: npm run deploy:registry
# REGISTRY_CONTRACT=0x... deployed contract address
# BOT_PRIVATE_KEY=0x... funded BOT Chain key that pays anchor gas
